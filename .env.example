# 복사해서 .env 로 사용하세요
# MySQL(utf8mb4 필수). 비밀번호에 @ : / # % 등 특수문자가 있으면 URL 인코딩 필요
DATABASE_URL=mysql+pymysql://adoz:비밀번호@localhost:3306/adoz?charset=utf8mb4
# MySQL 없이 간단히 돌려볼 때: DATABASE_URL=sqlite:///./adoz.db
# 반드시 긴 랜덤 문자열로 교체: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me
# https://platform.openai.com/api-keys 에서 발급. 비워두면 규칙 기반 분석(폴백)으로 동작
OPENAI_API_KEY=
# 모델명이 바뀌면 여기만 수정 (Structured Outputs 지원 모델이어야 함)
OPENAI_MODEL=gpt-5-mini
# OpenAI 호환 API 사용 시. 예) Groq(무료): https://api.groq.com/openai/v1 + OPENAI_MODEL=openai/gpt-oss-120b + AI_PROVIDER=groq
OPENAI_BASE_URL=
AI_PROVIDER=openai
# PDF 한글 폰트(선택). 기본값: ./fonts/NanumGothic-Regular.ttf
FONT_PATH=
SCHEDULER_ENABLED=true
REMINDER_HOUR=9
