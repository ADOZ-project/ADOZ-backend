# 복사해서 .env 로 사용하세요
DATABASE_URL=sqlite:///./hipass.db
# 반드시 긴 랜덤 문자열로 교체: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me
# https://aistudio.google.com/apikey 에서 발급. 비워두면 규칙 기반 분석(폴백)으로 동작
GEMINI_API_KEY=
# 모델명이 바뀌면 여기만 수정 (AI Studio 모델 목록 참고)
GEMINI_MODEL=gemini-flash-latest
# PDF 한글 폰트(선택). 기본값: ./fonts/NanumGothic-Regular.ttf
FONT_PATH=
SCHEDULER_ENABLED=true
REMINDER_HOUR=9
